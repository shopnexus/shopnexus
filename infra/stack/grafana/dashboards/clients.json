{
  "uid": "shopnexus-clients",
  "title": "Clients",
  "description": "What the website and the app see: page speed, script errors, request times on the network and search clicks.",
  "tags": [
    "shopnexus",
    "clients"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "custom",
        "query": "website,android",
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "website",
            "value": "website"
          },
          {
            "selected": false,
            "text": "android",
            "value": "android"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "LCP p75",
      "description": "Largest contentful paint of website page views; Google counts under 2.5 s as good.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(client_web_vital_duration_seconds_bucket{app=~\"$app\",name=\"LCP\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 2.5
              },
              {
                "color": "#d03b3b",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
