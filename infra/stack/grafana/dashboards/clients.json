    {
      "type": "table",
      "id": 16,
      "title": "Routes",
      "description": "App p95 minus server p95 is roughly the time on the network. Failed counts no answer and 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
