      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"server\",instance=~\"$instance\",http_route!~\"/(healthz|readyz)\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"server\",instance=~\"$instance\",http_route!~\"/(healthz|readyz)\"}[$__rate_interval]))",
