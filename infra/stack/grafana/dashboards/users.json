    {
      "type": "stat",
      "id": 2,
      "title": "Online now",
      "description": "Visitors with a request in the last 5 minutes: signed-in accounts, console members and guests (one guest per address a day). Bots are left out.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (visitor) (count_over_time({service_name=\"server\"} | visitor =~ \"[agm]:.+\" [5m])))",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto"
