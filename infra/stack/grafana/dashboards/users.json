            "type": "loki",
            "uid": "loki"
          },
          "expr": "count by (kind) (label_replace(label_replace(label_replace(sum by (visitor) (count_over_time({service_name=\"server\"} | visitor =~ \"[agm]:.+\" [1h])), \"kind\", \"Signed in\", \"visitor\", \"a:.*\"), \"kind\", \"Guests\", \"visitor\", \"g:.*\"), \"kind\", \"Console\", \"visitor\", \"m:.*\"))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{kind}}"
