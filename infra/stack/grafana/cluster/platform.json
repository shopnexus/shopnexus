    {
      "type": "timeseries",
      "id": 6,
      "title": "Requests / s by app",
      "description": "Every request through Traefik, the website, media and dashboards included.",
      "datasource": {
        "type": "prometheus",
        "uid": "cluster"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cluster"
          },
          "expr": "sum by (app) (label_replace(sum by (service) (rate(traefik_service_requests_total{service=~\"__NAMESPACE__-.*\"}[$__rate_interval])), \"app\", \"$1\", \"service\", \"__NAMESPACE__-(.+?)(-[0-9]+|-[0-9a-f]{20})@.*\"))",
          "refId": "A",
          "legendFormat": "{{app}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
