{
  "uid": "shopnexus-pods",
  "title": "Pods",
  "description": "The stack's pods and the cluster's nodes, from the cluster's Prometheus.",
  "tags": [
    "shopnexus",
    "kubernetes"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
