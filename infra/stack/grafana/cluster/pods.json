  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cluster"
        },
        "query": {
          "query": "label_values(kube_pod_status_phase, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(kube_pod_status_phase, namespace)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "__NAMESPACE__",
          "value": "__NAMESPACE__"
        }
