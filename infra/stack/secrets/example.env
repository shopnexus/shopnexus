# infra/cmd/seal copies this file to <stack>.env (git-ignored) on first use and adds
# the generated keys: JWT_KEY_ID, JWT_PRIVATE_KEY, STAFF_KEY,
# RESTATE_IDENTITY_KEY, OBJECT_STORE_ACCESS_KEY, OBJECT_STORE_SECRET_KEY,
# LITELLM_MASTER_KEY, LITELLM_DB_PASSWORD and LLM_API_KEY (the server's
# virtual key in LiteLLM).
# Fill in the two below. Both are required; an empty value is a setting.

# The key of the upstream OpenAI-compatible API behind LiteLLM
# (litellm.apiBase): today one of cli-proxy-api's access.api-keys.
LLM_UPSTREAM_API_KEY=
# A Firebase service account's JSON in base64. Empty logs pushes instead of
# sending them; APP_ENV=prod refuses it empty, so seal prod does too.
FCM_CREDENTIALS=
