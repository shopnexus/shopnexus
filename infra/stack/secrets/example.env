# infra/cmd/seal copies this file to <stack>.env (git-ignored) on first use and adds
# the generated keys: JWT_KEY_ID, JWT_PRIVATE_KEY, CONSOLE_KEY, OTP_KEY, CARRIER_TOKEN_KEY,
# RESTATE_IDENTITY_KEY, OBJECT_STORE_ROOT_ACCESS_KEY and
# OBJECT_STORE_ROOT_SECRET_KEY (RustFS's root), OBJECT_STORE_ACCESS_KEY and
# OBJECT_STORE_SECRET_KEY (the server's user), SNAPSHOTS_ACCESS_KEY and
# SNAPSHOTS_SECRET_KEY (Restate's user),
# LITELLM_MASTER_KEY (LiteLLM's, which the server uses for LiteLLM's admin
# API too), LITELLM_DB_PASSWORD, LITELLM_UI_PASSWORD (LiteLLM's
# admin UI), LLM_API_KEY (the server's key
# server-llm in LiteLLM), ASSIST_LLM_API_KEY
# (server-assist), TRUST_LLM_API_KEY (server-trust), EMBED_INDEX_API_KEY
# (server-embed-index), EMBED_SEARCH_API_KEY (server-embed-search),
# AGENT_SERVICE_TOKEN and AGENT_MCP_TOKEN (shared by the server and the
# console agent) and AGENT_LLM_API_KEY (the agent's key agent).
# Fill in the five below, and the carrier secrets for a carrier the stack
# runs live. All are required; an empty value is a setting.

# The stack's OpenRouter key, which LiteLLM (litellm/models/) sends
# for every alias on OpenRouter (embed-text). Give it a daily credit limit
# on OpenRouter, a stop behind LiteLLM's own budgets.
OPENROUTER_API_KEY=
# The key of the LLM upstream at LLM_UPSTREAM_BASE_URL (env/litellm.env),
# which LiteLLM sends for the LLM aliases (search, listing-read,
# scam-check, console-agent).
LLM_UPSTREAM_API_KEY=
# The username of LiteLLM's admin UI (litellm.<domain>, behind the
# console's sign-in); LITELLM_UI_PASSWORD is generated.
LITELLM_UI_USERNAME=
# A Firebase service account's JSON in base64. Empty logs pushes instead of
# sending them; APP_ENV=prod refuses it empty, so seal prod does too.
FCM_CREDENTIALS=
# Resend's API key for mailing sign-in codes. Required in prod
# (EMAIL_SENDER=resend); seal prod refuses it empty.
RESEND_API_KEY=
# A carrier the stack runs live (server.carriers.<name>.mode in its values
# file): ShopNexus's partner token there and the secret in its webhook
# path. Empty while the carrier is fake or off.
GHTK_PARTNER_TOKEN=
GHTK_WEBHOOK_SECRET=
GHN_PARTNER_TOKEN=
GHN_WEBHOOK_SECRET=
