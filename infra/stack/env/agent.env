# The console agent's settings that are the same in every stack, in the
# cluster and in docker-compose.yml (agent/src/config.ts). The chart adds
# them to the agent's env; compose reads this file with env_file. Settings
# that differ (the database host, the MCP URL, the keys) stay in
# templates/agent.yaml and in compose's x-agent-env-* blocks. Format:
# KEY=value, one per line, no quotes; an empty value is a setting.

PORT=3000
# LiteLLM's alias for the agent (litellm/config.yaml); the key is a secret.
AGENT_MODEL_ID=console-agent
LITELLM_BASE_URL=http://litellm:4000/v1
# The run bus: each turn's events and its stop and steer messages
# (templates/redis.yaml; redis in compose).
REDIS_URL=redis://redis:6379
# 0 for AGENT_MAX_TURNS leaves the tool-use cycles to the model, and the
# turn deadline bounds them.
AGENT_MAX_TOKENS=4096
AGENT_THINKING_BUDGET=0
AGENT_MAX_TURNS=0
AGENT_TOOL_OUTPUT_CAP=20000
AGENT_MEMORY_ENTRY_CAP=500
AGENT_MEMORY_MAX_ENTRIES=10
AGENT_CONVERSATION_WINDOW=40
AGENT_HISTORY_TURNS=20
AGENT_HISTORY_CHARS=60000
AGENT_TURN_DEADLINE_MS=60000
AGENT_SWEEP_INTERVAL_MS=60000
RETRIEVAL_CONTEXT_CHARS=12000
DOCUMENT_CHUNK_CHARS=2000
# No turn uses retrieval, so no embedding model.
EMBEDDING_MODEL_ID=
FEATURE_LLM=true
FEATURE_ALL_AGENT=true
POSTGRES_PORT=5432
POSTGRES_DB=agent
