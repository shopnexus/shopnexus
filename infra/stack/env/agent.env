# The agent runtime's settings that are the same in every stack, in the
# cluster and in docker-compose.yml (agent/cmd/agent). The chart adds
# them to agent's env; compose reads this file with env_file.
# Settings that differ (the server's address, the keys) stay in
# templates/agent.yaml and in compose's x-agent-env-*
# blocks. Format: KEY=value, one per line, no quotes; an empty value is a
# setting.

LISTEN=:8080
# The server sends each turn's model and gateway key, so the runtime has no
# default of either.
MODEL_BASE_URL=http://bifrost:8080/v1
MODEL=
MODEL_API_KEY=
# Workspaces: one tar.zst per conversation. objectstore-init-agent-workspaces
# makes the bucket and its user, and the lifecycle rule that removes a
# workspace WORKSPACE_EXPIRE_DAYS after its last turn.
WORKSPACE_BUCKET=agent-workspaces
WORKSPACE_CACHE=/var/lib/agent/workspaces
WORKSPACE_MAX_BYTES=1073741824
WORKSPACE_EXPIRE_DAYS=7
S3_ENDPOINT=garage:3900
S3_SECURE=false
# The sandbox installs npm, PyPI and Go packages through package-proxy,
# which holds back versions younger than 7 days.
PACKAGE_PROXY=package-proxy:8080
MAX_TURNS=8
TURN_MAX_DEADLINE=30m
# Each sandbox's limits, when the runtime can write its cgroup; empty
# SANDBOX_CGROUP leaves the pod's limits as the only ones.
SANDBOX_CGROUP=
SANDBOX_MEMORY_BYTES=2147483648
SANDBOX_PIDS=512
SANDBOX_CPUS=2
SANDBOX_READ_ONLY=
