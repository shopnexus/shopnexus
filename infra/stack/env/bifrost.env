# Bifrost's settings that every stack shares, in the cluster and in
# docker-compose.yml; the keys are in Secret bifrost-secrets, and in compose
# in infra/stack/secrets/compose.env and the keys volume. Format: KEY=value.

# The OpenAI-compatible API of provider upstream, without /v1.
LLM_UPSTREAM_BASE_URL=http://khoakomlem-internal.ddns.net:8317
BIFROST_ADMIN_USERNAME=admin
