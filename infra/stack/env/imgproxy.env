# imgproxy's settings that every stack shares, in the cluster and in
# docker-compose.yml. The stack chart adds them to imgproxy's env; compose
# reads this file with env_file. Format: KEY=value, one per line, no quotes.

# The website asks for /_img/_/<preset>/plain/<bucket>/<key>: no signature
# (the _ slot), presets only, the format left to the Accept header. imgproxy
# reads the photo from its cache's nginx, which serves the bucket's media/
# from Garage (imgproxy/nginx.conf); in compose that nginx has the same name.
IMGPROXY_BASE_URL=http://imgproxy-cache/
IMGPROXY_ALLOWED_SOURCES=http://imgproxy-cache/shopnexus/media/
IMGPROXY_PATH_PREFIX=/_img
IMGPROXY_ONLY_PRESETS=true
# sq*: square crops for cards and grids. w*: a width, the shape kept. No
# preset makes a photo larger than its source.
IMGPROXY_PRESETS=sq96=rs:fill:96:96:0/g:sm,sq160=rs:fill:160:160:0/g:sm,sq240=rs:fill:240:240:0/g:sm,sq320=rs:fill:320:320:0/g:sm,sq480=rs:fill:480:480:0/g:sm,sq640=rs:fill:640:640:0/g:sm,sq960=rs:fill:960:960:0/g:sm,w480=rs:fit:480:0:0,w720=rs:fit:720:0:0,w1080=rs:fit:1080:0:0,w1440=rs:fit:1440:0:0,w1920=rs:fit:1920:0:0

# AVIF or WebP when the browser accepts it, with Vary: Accept.
IMGPROXY_AUTO_AVIF=true
IMGPROXY_AUTO_WEBP=true
IMGPROXY_QUALITY=80
IMGPROXY_FORMAT_QUALITY=jpeg=80,webp=79,avif=60
IMGPROXY_AVIF_SPEED=8
IMGPROXY_STRIP_METADATA=true

# Media keys are UUIDs and never change, so answers keep for a year.
IMGPROXY_TTL=31536000
IMGPROXY_MAX_SRC_RESOLUTION=50
IMGPROXY_MAX_SRC_FILE_SIZE=20971520
IMGPROXY_WORKERS=2
