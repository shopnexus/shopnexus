# Grafana's settings that every stack shares, in the cluster and in
# docker-compose.yml. The stack chart adds them to lgtm's env; compose reads
# this file with env_file. Format: KEY=value, one per line, no quotes.

# Grafana signs in the member named by X-Console-Email and gives them the
# role in X-Console-Role (Admin or Viewer). In the cluster the dashboard-auth
# middleware sets both headers; locally Caddy sets them to an admin.
GF_AUTH_PROXY_ENABLED=true
GF_AUTH_PROXY_HEADER_NAME=X-Console-Email
GF_AUTH_PROXY_HEADER_PROPERTY=email
GF_AUTH_PROXY_HEADERS=Role:X-Console-Role
GF_AUTH_PROXY_AUTO_SIGN_UP=true
GF_AUTH_DISABLE_LOGIN_FORM=true
