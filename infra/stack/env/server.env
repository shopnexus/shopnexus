# The server's settings that are the same in every stack, in the cluster and
# in docker-compose.yml. The chart puts them in ConfigMap server-env; compose
# reads this file with env_file. A setting that differs between stacks or
# between the two stays in templates/_server-env.tpl and in compose's
# x-server-env-* blocks, and infra/check.sh fails when a key is in both
# places. Format: KEY=value, one per line, no quotes; an empty value is a
# setting.

HTTP_ADDR=:8080
SERVICE_NAME=server
RESTATE_LISTEN_ADDR=0.0.0.0:9080
RESTATE_SERVICE_PREFIX=
JWT_ISSUER=shopnexus
JWT_AUDIENCE=shopnexus-app
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=shopnexus

# The models behind the aliases embed-text and embed-image, stored with
# every vector, so a new one means a reindex. The server ignores the
# version of a kind whose model is empty. The similarity floors are
# starting values that the server's search eval tunes.
EMBED_TEXT_VERSION=bge-m3@5617a9f61b028005a4858fdac845db406aefb181
EMBED_IMAGE_VERSION=siglip2-so400m-patch16-384@29f74e673c298fd07482d8e20138179282001eb7-fp32
EMBED_TIMEOUT=15s
EMBED_SLOTS=2
EMBED_TEXT_MIN_SIMILARITY=0.45
EMBED_PHOTO_MIN_SIMILARITY=0.6

# Every model call goes to the stack's LiteLLM with an alias of
# litellm/models/ and the key of litellm/keys.txt for that purpose; the
# keys are secrets.
LLM_BASE_URL=http://litellm:4000/v1
LLM_MODEL=search
ASSIST_LLM_BASE_URL=http://litellm:4000/v1
ASSIST_LLM_MODEL=listing-read
TRUST_LLM_BASE_URL=http://litellm:4000/v1
TRUST_LLM_MODEL=scam-check
# LiteLLM's admin API, where the console's AI settings change providers,
# aliases and budgets. The master key is a secret.
LITELLM_URL=http://litellm:4000

# A read's one call to ai, speech to text, the model or Chợ Tốt. Link reads
# call Chợ Tốt's public gateway and the CDN its photos are on.
ASSIST_CALL_TIMEOUT=30s
CHOTOT_GATEWAY_URL=https://gateway.chotot.com
CHOTOT_CDN_URL=https://cdn.chotot.com
# A scam check's one call to the model.
TRUST_CALL_TIMEOUT=20s

# The console agent's MCP server, on a port only the agent reaches.
AGENT_MCP_ADDR=0.0.0.0:9090

# How often a shipped order's shipment is read from its carrier. The GHTK
# and GHN settings are for CARRIER=live, which no stack runs yet.
CARRIER_POLL_EVERY=2h
GHTK_API_URL=
GHTK_PARTNER_TOKEN=
GHTK_CLIENT_SOURCE=
GHTK_WEBHOOK_SECRET=
GHN_API_URL=
GHN_WEBHOOK_SECRET=

FIREBASE_PROJECT_ID=shopnexus-26aca
FIREBASE_PROJECT_NUMBER=5362373878
FIREBASE_AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
PNV_JWKS_URL=https://fpnv.googleapis.com/v1beta/jwks
# The sender address of sign-in codes; its domain is verified at Resend.
EMAIL_FROM=ShopNexus <no-reply@shopnexus.id.vn>
# The Web OAuth client of the Firebase project; empty turns Google sign-in
# off.
GOOGLE_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# true: console members sign in with the email and password alone, no TOTP
# step. Remove the line, or set false, to require TOTP again.
CONSOLE_SKIP_TOTP=true

# Module ai (speech, photo vectors, video frames) runs in the server
# process whose SERVER_ROLE is all or ai, with the model files under
# /models. AI_EMBED_MODELS, the photo model, is set per stack.
AI_STT_MODELS=gipformer-1.5=/models/gipformer-1.5
AI_VAD_MODEL=/models/silero_vad.onnx
AI_NUM_THREADS=4
AI_MAX_CONCURRENT=2
AI_MAX_AUDIO_SECONDS=300
AI_EMBED_MAX_INPUTS=16
AI_EMBED_MAX_CONCURRENT=2
AI_EMBED_MAX_IMAGE_MB=10
AI_FRAMES_MAX_CONCURRENT=2
AI_FRAMES_MAX_SECONDS=35
AI_FRAMES_MIN_SHARPNESS=30
