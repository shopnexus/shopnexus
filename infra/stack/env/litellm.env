# LiteLLM's settings that every stack shares, in the cluster and in
# docker-compose.yml. The stack chart adds them to LiteLLM's env; compose
# reads this file with env_file. The keys are not here: they are in Secret
# litellm-secrets, and in compose in infra/stack/secrets/compose.env. Format:
# KEY=value, one per line, no quotes.

# The OpenAI-compatible API behind the LLM aliases of litellm/config.yaml.
LLM_UPSTREAM_BASE_URL=http://khoakomlem-internal.ddns.net:8317/v1
