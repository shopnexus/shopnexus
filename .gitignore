# Everything at the top of the repository is ignored unless listed here, so
# a stray file there is never committed by accident. A new top-level file or
# directory needs its own line.
/*
!/.env.example
!/.github/
!/.gitignore
!/.gitmodules
!/LICENSE
!/Makefile
!/README.md
!/app
!/console
!/docker-compose.yml
!/docs
!/infra/
!/server
!/website

# Inside the directories above:
# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local data
.claude/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Env / secrets
.env
.env.*
!.env.example
*.local

# Logs
*.log
logs/

# Docker / runtime volumes
volumes/
data/

# Node / build artifacts (root-level tooling only; submodules manage their own)
node_modules/
dist/
build/
.cache/
tmp/

# Plain secrets that infra/cmd/seal keeps; only the sealed YAML is committed.
infra/stack/secrets/*.env
!infra/stack/secrets/example.env
infra/stack/secrets/*.pem

# helm-unittest writes snapshots here; the suites use none.
infra/stack/tests/__snapshot__/
